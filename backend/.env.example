# ============================================================
# NEXUS RESQ — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================================

PORT=8000
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=nexus_resq_db

DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/nexus_resq_db

CORS_ORIGIN=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_here

# Google Maps Platform / Location Services
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ADDRESS_VALIDATION_API_KEY=
GOOGLE_ROUTES_API_KEY=

# AI Services
GEMINI_API_KEY=
OPENAI_API_KEY=
